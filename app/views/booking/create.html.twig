{% extends "layouts/app.html.twig" %}

{% block title %}Ajukan Peminjaman Ruang Acara - Jadwal Kelas FST{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Form Peminjaman Ruangan Acara</h1>
            <p class="text-sm text-slate-500 mt-1">Gunakan form ini untuk meminjam ruangan lokal FST bagi kegiatan organisasi/kepanitiaan.</p>
        </div>
        <a href="/booking/list" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
            Lihat Status Pengajuan &rarr;
        </a>
    </div>

    <!-- Alert / Notice about lecture priority -->
    <div class="bg-blue-50 border border-blue-200 p-4 rounded-2xl flex items-start gap-3">
        <svg class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div class="text-xs text-blue-900 leading-relaxed">
            <span class="font-bold block text-blue-950 mb-0.5">Aturan Prioritas Perkuliahan</span>
            Sistem secara otomatis mendeteksi jadwal perkuliahan reguler. Peminjaman acara <strong>tidak dapat disetujui</strong> jika bertabrakan dengan jadwal kuliah di ruangan dan jam yang sama.
        </div>
    </div>

    {% if error %}
    <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm px-4 py-3 rounded-2xl">
        {{ error }}
    </div>
    {% endif %}

    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
        <form action="/booking/store" method="POST" class="space-y-4">
            <!-- Room Selection -->
            <div>
                <label for="booking_room_id" class="block text-sm font-semibold text-slate-700 mb-1.5">
                    Pilih Ruang Kelas Lokal <span class="text-rose-500">*</span>
                </label>
                <select id="booking_room_id" name="room_id" required
                    class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 text-sm">
                    <option value="">-- Pilih Ruangan FST --</option>
                    {% for r in rooms %}
                        <option value="{{ r.id }}" {% if selected_room == r.id %}selected{% endif %}>
                            {{ r.name }} ({{ r.room_type }} - Kapasitas {{ r.capacity }} orang)
                        </option>
                    {% endfor %}
                </select>
            </div>

            <!-- Date & Time Row -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="booking_date" class="block text-sm font-semibold text-slate-700 mb-1.5">
                        Tanggal Kegiatan <span class="text-rose-500">*</span>
                    </label>
                    <input type="date" id="booking_date" name="booking_date" required min="{{ "now"|date("Y-m-d") }}"
                        class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 text-sm">
                </div>

                <div>
                    <label for="booking_start_time" class="block text-sm font-semibold text-slate-700 mb-1.5">
                        Jam Mulai <span class="text-rose-500">*</span>
                    </label>
                    <input type="time" id="booking_start_time" name="start_time" required
                        class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 text-sm">
                </div>

                <div>
                    <label for="booking_end_time" class="block text-sm font-semibold text-slate-700 mb-1.5">
                        Jam Selesai <span class="text-rose-500">*</span>
                    </label>
                    <input type="time" id="booking_end_time" name="end_time" required
                        class="w-full px-3 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 text-sm">
                </div>
            </div>

            <!-- Dynamic Availability Status Banner -->
            <div id="availability-status-container" class="hidden transition-all duration-200"></div>

            <!-- Event Details -->
            <div>
                <label for="event_name" class="block text-sm font-semibold text-slate-700 mb-1.5">
                    Nama Kegiatan / Acara <span class="text-rose-500">*</span>
                </label>
                <input type="text" id="event_name" name="event_name" required
                    placeholder="Contoh: Workshop Cloud Computing HMTI"
                    class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 text-sm">
            </div>

            <div>
                <label for="organizer" class="block text-sm font-semibold text-slate-700 mb-1.5">
                    Organisasi / Kepanitiaan Penyelenggara <span class="text-rose-500">*</span>
                </label>
                <input type="text" id="organizer" name="organizer" required
                    placeholder="Contoh: HMTI / BEM FST / Panitia Dies Natalis"
                    class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 text-sm">
            </div>

            <div>
                <label for="description" class="block text-sm font-semibold text-slate-700 mb-1.5">
                    Deskripsi & Kebutuhan Fasilitas
                </label>
                <textarea id="description" name="description" rows="3"
                    placeholder="Tuliskan keterangan kegiatan, jumlah peserta estimasi, atau kebutuhan proyektor/audio..."
                    class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-800 text-sm"></textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a href="/" class="px-4 py-2.5 text-sm font-semibold text-slate-600 hover:text-slate-800 transition-colors">
                    Batal
                </a>
                <button type="submit" id="booking-submit-btn"
                    class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl shadow-xs hover:shadow-md transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                    Kirim Permohonan
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/conflict-check.js"></script>
{% endblock %}
