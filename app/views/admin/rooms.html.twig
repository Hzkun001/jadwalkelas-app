{% extends "layouts/app.html.twig" %}

{% block title %}Kelola Master Ruangan - Admin Jadwal Kelas FST{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Master Data Ruang Kelas Lokal FST</h1>
            <p class="text-sm text-slate-500 mt-1">Daftar ruangan teori dan laboratorium komputer di lingkungan Fakultas Sains dan Teknologi.</p>
        </div>
        <a href="/admin" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
            &larr; Kembali ke Verifikasi Peminjaman
        </a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                    <tr>
                        <th class="py-3.5 px-4">Kode Ruang</th>
                        <th class="py-3.5 px-4">Nama Tampilan</th>
                        <th class="py-3.5 px-4">Lokasi Gedung</th>
                        <th class="py-3.5 px-4">Tipe</th>
                        <th class="py-3.5 px-4">Kapasitas</th>
                        <th class="py-3.5 px-4">Status Operasional</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for r in rooms %}
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="py-3.5 px-4 font-mono font-bold text-indigo-600">
                            {{ r.code }}
                        </td>
                        <td class="py-3.5 px-4 font-bold text-slate-900">
                            {{ r.name }}
                        </td>
                        <td class="py-3.5 px-4 text-slate-600">
                            {{ r.building }}
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wider bg-slate-100 text-slate-700">
                                {{ r.room_type }}
                            </span>
                        </td>
                        <td class="py-3.5 px-4 font-medium text-slate-700">
                            {{ r.capacity }} kursi
                        </td>
                        <td class="py-3.5 px-4">
                            {% if r.is_active %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                    Aktif Digunakan
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800">
                                    Nonaktif / Perbaikan
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
