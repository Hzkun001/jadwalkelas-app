{% extends "layouts/app.html.twig" %}

{% block title %}Status Ketersediaan Ruangan FST - Gedung Saintek & Lab{% endblock %}

{% block content %}
<div class="space-y-8">
    <!-- Top Info Bar -->
    <div class="bg-white rounded-3xl border-2 border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black bg-indigo-100 text-indigo-900 border border-indigo-200 mb-2">
                <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
                <span>STATUS LANGSUNG (LIVE)</span>
                <span>&bull;</span>
                <span>{{ day_name }}, {{ current_date }}</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
                Status 8 Ruang Kelas & Laboratorium FST
            </h1>
            <p class="text-sm font-semibold text-slate-600 mt-1">
                Waktu sistem: <strong class="text-indigo-700 font-mono text-base font-black">{{ current_time }} WIB</strong> &bull; Total: 5 Ruang Teori Saintek & 3 Lab Komputer.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/" class="inline-flex items-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-black rounded-xl shadow-xs transition-all hover:scale-[1.02]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span>Buka Kalender Jadwal</span>
            </a>
            <a href="/booking/create" class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-black rounded-xl shadow-xs transition-all hover:scale-[1.02]">
                Pinjam Ruang
            </a>
        </div>
    </div>

    <!-- Quick Status Pill Counters -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 rounded-2xl bg-emerald-50 border-2 border-emerald-300 flex items-center justify-between">
            <div>
                <span class="text-xs font-black uppercase tracking-wider text-emerald-900 block">KOSONG SEKARANG</span>
                <span class="text-2xl sm:text-3xl font-black text-emerald-800">{{ stats.available }} <span class="text-sm font-bold text-emerald-950">Ruangan</span></span>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold text-lg">
                ✓
            </div>
        </div>
        <div class="p-4 rounded-2xl bg-rose-50 border-2 border-rose-300 flex items-center justify-between">
            <div>
                <span class="text-xs font-black uppercase tracking-wider text-rose-900 block">SEDANG KULIAH</span>
                <span class="text-2xl sm:text-3xl font-black text-rose-800">{{ stats.lecture }} <span class="text-sm font-bold text-rose-950">Ruangan</span></span>
            </div>
            <div class="w-10 h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center font-bold text-lg">
                📖
            </div>
        </div>
        <div class="p-4 rounded-2xl bg-amber-50 border-2 border-amber-300 flex items-center justify-between">
            <div>
                <span class="text-xs font-black uppercase tracking-wider text-amber-950 block">SEDANG ACARA</span>
                <span class="text-2xl sm:text-3xl font-black text-amber-900">{{ stats.event }} <span class="text-sm font-bold text-amber-950">Ruangan</span></span>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-bold text-lg">
                🎪
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- BAGIAN 1: GEDUNG SAINTEK (5 RUANG TEORI)   -->
    <!-- ========================================== -->
    <div class="space-y-4">
        <div class="flex items-center justify-between pb-2 border-b-2 border-slate-200">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">
                    🏢
                </span>
                <div>
                    <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">Gedung Saintek</h2>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">5 Ruang Kelas Teori Lokal FST (fst 1.1 s.d. fst 3.6)</p>
                </div>
            </div>
            <span class="px-3 py-1 bg-slate-100 border border-slate-300 rounded-full text-xs font-black text-slate-700">
                5 Ruangan
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for room in saintek_rooms %}
            <div class="bg-white rounded-3xl border-2 border-slate-200 border-l-[8px] {{ room.status_border }} p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
                <div class="space-y-3">
                    <!-- Header Ruang -->
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <h3 class="text-2xl font-black text-slate-900 leading-none tracking-tight">{{ room.name }}</h3>
                            <p class="text-xs font-bold text-slate-500 mt-1">
                                {{ room.building }} &bull; Kapasitas {{ room.capacity }} Kursi
                            </p>
                        </div>

                        {% if room.status == 'empty' %}
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-black bg-emerald-600 text-white shadow-2xs">
                            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                            KOSONG
                        </span>
                        {% elseif room.status == 'lecture' %}
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-black bg-rose-600 text-white shadow-2xs">
                            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                            KULIAH
                        </span>
                        {% else %}
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-black bg-amber-500 text-slate-950 shadow-2xs">
                            ACARA
                        </span>
                        {% endif %}
                    </div>

                    <!-- Isi Kegiatan -->
                    {% if room.status == 'lecture' %}
                    <div class="p-3.5 bg-rose-50 border-2 border-rose-200 rounded-2xl space-y-1.5">
                        <span class="text-[10px] font-black uppercase text-rose-800 tracking-wider block">SEDANG ADA KULIAH:</span>
                        <div class="text-base font-black text-rose-950 leading-tight">{{ room.current_activity.course_name }}</div>
                        <div class="text-xs font-bold text-rose-900 flex items-center justify-between pt-1">
                            <span>Kelas: {{ room.current_activity.class_name }}</span>
                            <span class="font-mono bg-rose-100 text-rose-900 px-2 py-0.5 rounded font-black">{{ room.current_activity.start_time }} - {{ room.current_activity.end_time }}</span>
                        </div>
                        {% if room.current_activity.lecturer_name %}
                        <div class="text-xs font-semibold text-slate-700">Dosen: <strong class="text-slate-900">{{ room.current_activity.lecturer_name }}</strong></div>
                        {% endif %}
                        <div class="text-xs font-black text-rose-700 pt-1 flex items-center gap-1">
                            ⏱️ Selesai pukul {{ room.current_activity.end_time }} WIB
                        </div>
                    </div>
                    {% elseif room.status == 'event' %}
                    <div class="p-3.5 bg-amber-50 border-2 border-amber-200 rounded-2xl space-y-1.5">
                        <span class="text-[10px] font-black uppercase text-amber-900 tracking-wider block">SEDANG DIGUNAKAN ACARA:</span>
                        <div class="text-base font-black text-amber-950 leading-tight">{{ room.current_activity.event_name }}</div>
                        <div class="text-xs font-bold text-amber-900 flex items-center justify-between pt-1">
                            <span>Oleh: {{ room.current_activity.organizer }}</span>
                            <span class="font-mono bg-amber-100 text-amber-900 px-2 py-0.5 rounded font-black">{{ room.current_activity.start_time }} - {{ room.current_activity.end_time }}</span>
                        </div>
                        <div class="text-xs font-black text-amber-800 pt-1 flex items-center gap-1">
                            ⏱️ Selesai pukul {{ room.current_activity.end_time }} WIB
                        </div>
                    </div>
                    {% else %}
                    <!-- Ruang Kosong -->
                    <div class="p-3.5 bg-emerald-50 border-2 border-emerald-200 rounded-2xl space-y-2">
                        <div class="text-sm font-black text-emerald-900 flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                            RUANGAN BEBAS DIGUNAKAN
                        </div>
                        {% if room.next_activity %}
                        <div class="text-xs font-semibold text-slate-800 bg-white/95 p-2.5 rounded-xl border border-emerald-200 space-y-0.5">
                            <div class="text-emerald-950 font-black">⏱️ Bebas s.d. pukul {{ room.next_activity.start_time }} WIB</div>
                            <div class="text-slate-600">Lanjut: <strong class="text-slate-900">{{ room.next_activity.title }}</strong></div>
                        </div>
                        {% else %}
                        <div class="text-xs font-bold text-emerald-900 bg-white/90 p-2.5 rounded-xl border border-emerald-200">
                            🎉 Bebas hingga jam kuliah berakhir hari ini.
                        </div>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>

                <!-- Footer Card Buttons -->
                <div class="pt-3 mt-3 border-t-2 border-slate-100 grid grid-cols-2 gap-2">
                    <a href="/?room={{ room.id }}" class="py-2 px-3 rounded-xl text-xs font-black text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors text-center">
                        Cek Jadwal
                    </a>
                    <a href="/booking/create?room_id={{ room.id }}" class="py-2 px-3 rounded-xl text-xs font-black text-slate-800 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-colors text-center">
                        Pinjam Ruang
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- ========================================== -->
    <!-- BAGIAN 2: GEDUNG LAB KOMPUTER (3 LAB)     -->
    <!-- ========================================== -->
    <div class="space-y-4 pt-4">
        <div class="flex items-center justify-between pb-2 border-b-2 border-slate-200">
            <div class="flex items-center gap-2">
                <span class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">
                    💻
                </span>
                <div>
                    <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">Gedung Lab Komputer</h2>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">3 Ruang Laboratorium Komputer & Jaringan (lab-int-internet-1 s.d. 3)</p>
                </div>
            </div>
            <span class="px-3 py-1 bg-slate-100 border border-slate-300 rounded-full text-xs font-black text-slate-700">
                3 Laboratorium
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for room in lab_rooms %}
            <div class="bg-white rounded-3xl border-2 border-slate-200 border-l-[8px] {{ room.status_border }} p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
                <div class="space-y-3">
                    <!-- Header Ruang -->
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <h3 class="text-xl sm:text-2xl font-black text-slate-900 leading-none tracking-tight">{{ room.name }}</h3>
                            <p class="text-xs font-bold text-slate-500 mt-1">
                                {{ room.building }} &bull; Kapasitas {{ room.capacity }} Unit PC
                            </p>
                        </div>

                        {% if room.status == 'empty' %}
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-black bg-emerald-600 text-white shadow-2xs">
                            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                            KOSONG
                        </span>
                        {% elseif room.status == 'lecture' %}
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-black bg-rose-600 text-white shadow-2xs">
                            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                            PRAKTIKUM
                        </span>
                        {% else %}
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-black bg-amber-500 text-slate-950 shadow-2xs">
                            ACARA
                        </span>
                        {% endif %}
                    </div>

                    <!-- Isi Kegiatan -->
                    {% if room.status == 'lecture' %}
                    <div class="p-3.5 bg-rose-50 border-2 border-rose-200 rounded-2xl space-y-1.5">
                        <span class="text-[10px] font-black uppercase text-rose-800 tracking-wider block">SEDANG PRAKTIKUM:</span>
                        <div class="text-base font-black text-rose-950 leading-tight">{{ room.current_activity.course_name }}</div>
                        <div class="text-xs font-bold text-rose-900 flex items-center justify-between pt-1">
                            <span>Kelas: {{ room.current_activity.class_name }}</span>
                            <span class="font-mono bg-rose-100 text-rose-900 px-2 py-0.5 rounded font-black">{{ room.current_activity.start_time }} - {{ room.current_activity.end_time }}</span>
                        </div>
                        {% if room.current_activity.lecturer_name %}
                        <div class="text-xs font-semibold text-slate-700">Dosen: <strong class="text-slate-900">{{ room.current_activity.lecturer_name }}</strong></div>
                        {% endif %}
                        <div class="text-xs font-black text-rose-700 pt-1 flex items-center gap-1">
                            ⏱️ Selesai pukul {{ room.current_activity.end_time }} WIB
                        </div>
                    </div>
                    {% elseif room.status == 'event' %}
                    <div class="p-3.5 bg-amber-50 border-2 border-amber-200 rounded-2xl space-y-1.5">
                        <span class="text-[10px] font-black uppercase text-amber-900 tracking-wider block">SEDANG DIGUNAKAN:</span>
                        <div class="text-base font-black text-amber-950 leading-tight">{{ room.current_activity.event_name }}</div>
                        <div class="text-xs font-bold text-amber-900 flex items-center justify-between pt-1">
                            <span>Oleh: {{ room.current_activity.organizer }}</span>
                            <span class="font-mono bg-amber-100 text-amber-900 px-2 py-0.5 rounded font-black">{{ room.current_activity.start_time }} - {{ room.current_activity.end_time }}</span>
                        </div>
                        <div class="text-xs font-black text-amber-800 pt-1 flex items-center gap-1">
                            ⏱️ Selesai pukul {{ room.current_activity.end_time }} WIB
                        </div>
                    </div>
                    {% else %}
                    <!-- Lab Kosong -->
                    <div class="p-3.5 bg-emerald-50 border-2 border-emerald-200 rounded-2xl space-y-2">
                        <div class="text-sm font-black text-emerald-900 flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                            LAB KOSONG & BEBAS
                        </div>
                        {% if room.next_activity %}
                        <div class="text-xs font-semibold text-slate-800 bg-white/95 p-2.5 rounded-xl border border-emerald-200 space-y-0.5">
                            <div class="text-emerald-950 font-black">⏱️ Bebas s.d. pukul {{ room.next_activity.start_time }} WIB</div>
                            <div class="text-slate-600">Lanjut: <strong class="text-slate-900">{{ room.next_activity.title }}</strong></div>
                        </div>
                        {% else %}
                        <div class="text-xs font-bold text-emerald-900 bg-white/90 p-2.5 rounded-xl border border-emerald-200">
                            🎉 Bebas praktikum hari ini (tidak ada jadwal lagi).
                        </div>
                        {% endif %}
                    </div>
                    {% endif %}
                </div>

                <!-- Footer Card Buttons -->
                <div class="pt-3 mt-3 border-t-2 border-slate-100 grid grid-cols-2 gap-2">
                    <a href="/?room={{ room.id }}" class="py-2 px-3 rounded-xl text-xs font-black text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors text-center">
                        Cek Jadwal
                    </a>
                    <a href="/booking/create?room_id={{ room.id }}" class="py-2 px-3 rounded-xl text-xs font-black text-slate-800 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-colors text-center">
                        Pinjam Lab
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
