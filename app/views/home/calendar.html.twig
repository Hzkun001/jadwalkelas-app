{% extends "layouts/app.html.twig" %}

{% block title %}Kalender Jadwal Kuliah & Ruangan FST - Jadwal Kelas App{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Top Action & Filter Bar -->
    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <!-- Date Navigation -->
        <div class="flex items-center gap-3">
            <div class="flex items-center bg-slate-100 rounded-xl p-1 gap-1">
                <button id="btn-prev" class="p-1.5 rounded-lg hover:bg-white hover:shadow-2xs text-slate-700 transition-all" title="Sebelumnya">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>
                <button id="btn-today" class="px-3 py-1 text-xs font-bold text-slate-700 hover:bg-white hover:shadow-2xs rounded-lg transition-all">
                    Hari Ini
                </button>
                <button id="btn-next" class="p-1.5 rounded-lg hover:bg-white hover:shadow-2xs text-slate-700 transition-all" title="Berikutnya">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>
            </div>

            <h1 id="calendar-title" class="text-lg md:text-xl font-bold text-slate-900 tracking-tight">
                Memuat tanggal...
            </h1>
        </div>

        <!-- Controls: Room Filter & Mode Toggles -->
        <div class="flex flex-wrap items-center gap-3">
            <!-- Room Selector -->
            <div class="flex items-center gap-2">
                <label for="room-filter-select" class="text-xs font-bold text-slate-500 uppercase tracking-wider whitespace-nowrap">Ruangan:</label>
                <select id="room-filter-select" class="bg-slate-50 border border-slate-200 text-slate-800 text-sm font-semibold rounded-xl px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    <option value="0">Semua Ruang Lokal FST</option>
                    {% for r in rooms %}
                        <option value="{{ r.id }}">{{ r.name }} ({{ r.room_type }})</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Mode Switch (Week vs Month) -->
            <div class="flex items-center bg-slate-100 rounded-xl p-1 gap-1">
                <button id="btn-mode-week" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-indigo-600 text-white shadow-xs">
                    Mingguan
                </button>
                <button id="btn-mode-month" class="px-3 py-1.5 text-xs font-bold rounded-lg text-slate-600 hover:bg-slate-200/60">
                    Bulanan
                </button>
            </div>

            <!-- Quick booking button -->
            <a href="/booking/create" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl shadow-xs transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Pinjam Ruang
            </a>
        </div>
    </div>

    <!-- Color Legend -->
    <div class="flex items-center gap-4 text-xs font-medium text-slate-600 px-1">
        <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-md bg-blue-600"></span>
            <span>Kuliah Reguler (Prioritas #1)</span>
        </div>
        <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-md bg-amber-600"></span>
            <span>Peminjaman Acara Ormawa</span>
        </div>
        <div class="text-slate-400 italic text-[11px] ml-auto hidden sm:block">
            * Klik salah satu kegiatan di kalender untuk melihat rincian lengkap
        </div>
    </div>

    <!-- Calendar Viewport Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
        <div id="timetable-calendar">
            <!-- Dynamic calendar content rendered by calendar.js -->
        </div>
    </div>
</div>

<!-- Modal Detail Kegiatan -->
<div id="event-detail-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 space-y-4 animate-in fade-in zoom-in duration-150">
        <div class="flex items-start justify-between gap-3">
            <div>
                <span id="modal-badge" class="inline-block px-2.5 py-1 text-xs font-bold rounded-lg bg-blue-100 text-blue-800 mb-2">
                    Tipe Kegiatan
                </span>
                <h2 id="modal-title" class="text-xl font-bold text-slate-900 leading-tight">Nama Kegiatan</h2>
            </div>
            <button id="modal-close-btn" class="p-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="space-y-3 pt-2 border-t border-slate-100 text-sm">
            <div class="flex items-center gap-3 text-slate-600">
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div id="modal-time" class="text-slate-800">Waktu pelaksanaan</div>
            </div>

            <div class="flex items-center gap-3 text-slate-600">
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                <div>
                    <span class="text-slate-500">Ruangan:</span>
                    <span id="modal-room" class="font-bold text-slate-900">Nama Ruangan</span>
                </div>
            </div>

            <div class="p-3 bg-slate-50 rounded-xl space-y-1">
                <div id="modal-extra-label" class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Detail Pelaksana</div>
                <div id="modal-extra-value" class="text-sm font-bold text-slate-800">Nama Penyelenggara / Dosen</div>
            </div>
        </div>

        <div class="pt-3 border-t border-slate-100 text-right">
            <button onclick="document.getElementById('event-detail-modal').classList.add('hidden')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors">
                Tutup
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/calendar.js"></script>
{% endblock %}
