{
    "name": "jadwalkelas/app",
    "description": "Jadwal Kelas App - Sistem Monitoring Ruang Kelas & Pencegahan Bentrok FST",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "ext-pdo": "*",
        "flightphp/core": "^3.18",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "@php -d extension=ext/pdo_sqlite.so -S localhost:8000 -t public",
        "test": "@php -d extension=ext/pdo_sqlite.so vendor/bin/phpunit"
    }
}
